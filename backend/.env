# Copy this file to ".env" and fill in your own values.
# ".env" holds secrets and is never committed to Git.

# Port the API listens on
PORT=5000

# Address of the React app (used by CORS so the browser allows its requests)
CLIENT_URL=http://localhost:5173

# MySQL connection (use the same user/password you use in MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mabdul123
DB_NAME=localmarket

# Used from Slice 1 (login tokens). Replace with a long random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
